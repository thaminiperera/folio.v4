---
import { getCollection, render } from "astro:content";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import HoverArrow from "../../components/HoverArrow.astro";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      next: projects[(index + 1) % projects.length],
    },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
---

<Base title={project.data.title} description={project.data.summary}>
  <Header />
  <main id="main" class="mx-auto max-w-3xl px-6 pb-8 pt-14 md:px-8 md:pt-20">
    <p class="label text-ink-soft">
      <a class="link-underline" href="/#work">Projects</a>
      <span aria-hidden="true"> / </span>
      {project.data.title}
    </p>
    <h1 class="font-display mt-5 text-[2.25rem] font-bold leading-[1.15] text-ink md:text-[3rem]">
      {project.data.title}
    </h1>
    <p class="mt-5 max-w-2xl leading-relaxed text-ink-soft">
      {project.data.summary}
    </p>
    <p class="mt-6 text-sm text-ink-soft">{project.data.stack.join(" · ")}</p>
    <p class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
      <a
        class="hover-arrow-link link-underline"
        href={project.data.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>GitHub</span>
        <HoverArrow />
      </a>
      {
        project.data.demo && (
          <a
            class="hover-arrow-link link-underline"
            href={project.data.demo}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Live Demo</span>
            <HoverArrow />
          </a>
        )
      }
    </p>

    <article
      class="prose-work mt-14 max-w-2xl space-y-5 text-[0.98rem] leading-relaxed text-ink-soft [&_h2]:mt-12 [&_h2]:font-display [&_h2]:text-[1.35rem] [&_h2]:font-bold [&_h2]:text-ink [&_strong]:font-medium [&_strong]:text-ink [&_p]:max-w-prose [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5 [&_li]:max-w-prose [&_figure.project-figure]:my-8 [&_figure.project-figure]:flex [&_figure.project-figure]:flex-col [&_figure.project-figure]:items-center [&_figure.project-figure]:text-center [&_figure.project-figure_img]:h-auto [&_figure.project-figure_img]:w-full [&_figure.project-figure_img]:max-w-full [&_figure.project-figure_figcaption]:mt-3 [&_figure.project-figure_figcaption]:text-[0.8rem] [&_figure.project-figure_figcaption]:italic [&_figure.project-figure_figcaption]:text-ink-soft"
    >
      <Content />
    </article>

    <p class="mt-16 border-t border-rule pt-8 text-sm">
      <a class="hover-arrow-link text-ink-soft" href={`/work/${next.id}`}>
        <strong class="font-bold text-ink">Next:</strong>
        <span class="link-underline">{next.data.title}</span>
        <HoverArrow />
      </a>
    </p>
  </main>
  <Footer />
</Base>
