---
import { experience } from "../site";
---

<section id="experience" class="mt-20" aria-labelledby="experience-heading">
  <h2 id="experience-heading" class="label">Experience</h2>
  <ol class="mt-8 space-y-12">
    {
      experience.map((item) => (
        <li class="grid gap-2 md:grid-cols-[10.5rem_1fr] md:gap-10">
          <p class="text-sm text-ink-soft">{item.dates}</p>
          <div>
            <h3 class="font-display text-[1.35rem] font-bold leading-snug text-ink">
              {item.role}
            </h3>
            <p class="mt-1 text-ink-soft">{item.org}</p>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-[0.95rem] leading-relaxed text-ink-soft marker:text-ink">
              {item.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>
