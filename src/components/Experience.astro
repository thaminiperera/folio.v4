---
import { experience } from "../site";
---

<section id="experience" class="mt-24" aria-labelledby="experience-heading">
  <h2 id="experience-heading" class="small-caps text-sm text-ink-soft">Experience</h2>
  <ol class="mt-8 space-y-10">
    {
      experience.map((item) => (
        <li class="grid gap-1 md:grid-cols-[11rem_1fr] md:gap-8">
          <p class="small-caps text-sm text-ink-soft">{item.dates}</p>
          <div>
            <p class="font-display text-xl text-ink">
              {item.role}
              <span class="text-ink-soft"> · {item.org}</span>
            </p>
            <p class="mt-2 max-w-prose leading-relaxed text-ink-soft">{item.detail}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
