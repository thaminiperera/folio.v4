---
import { skills } from "../site";
---

<section id="skills" class="mt-24" aria-labelledby="skills-heading">
  <h2 id="skills-heading" class="small-caps text-sm text-ink-soft">Skills</h2>
  <dl class="mt-8 grid gap-10 sm:grid-cols-2">
    {
      Object.entries(skills).map(([group, items]) => (
        <div>
          <dt class="font-display text-xl text-ink">{group}</dt>
          <dd class="mt-2 text-[1.05rem] leading-relaxed text-ink-soft">{items.join(" · ")}</dd>
        </div>
      ))
    }
  </dl>
</section>
