---
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"work">[];
}

const { projects } = Astro.props;
---

<section id="work" class="mt-24" aria-labelledby="work-heading">
  <h2 id="work-heading" class="small-caps text-sm text-ink-soft">Selected work</h2>
  <ul class="mt-8 divide-y divide-rule border-y border-rule">
    {
      projects.map((project, i) => (
        <li>
          <a
            href={`/work/${project.id}`}
            class="group grid gap-3 py-8 transition-colors md:grid-cols-[2rem_1fr_auto] md:items-baseline md:gap-8"
          >
            <span class="small-caps text-sm text-ink-soft">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="font-display text-2xl text-ink group-hover:text-accent md:text-[1.7rem]">
                {project.data.title}
              </h3>
              <p class="mt-2 max-w-prose leading-relaxed text-ink-soft">{project.data.tagline}</p>
              <p class="mt-3 text-sm text-ink-soft">{project.data.stack.join(" · ")}</p>
            </div>
            <span class="text-sm text-accent underline-offset-4 group-hover:underline">
              Read
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
