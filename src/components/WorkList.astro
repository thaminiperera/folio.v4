---
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"work">[];
}

const { projects } = Astro.props;
---

<section id="work" class="mt-20" aria-labelledby="work-heading">
  <h2 id="work-heading" class="label">Projects</h2>
  <ul class="mt-8 divide-y divide-rule border-y border-rule">
    {
      projects.map((project, i) => (
        <li>
          <a
            href={`/work/${project.id}`}
            class="group grid grid-cols-1 gap-y-6 py-7 md:grid-cols-[2rem_1fr_auto] md:items-baseline md:gap-x-8 md:gap-y-2"
          >
            <span class="text-sm text-ink-soft">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="font-display text-[1.45rem] font-bold leading-snug text-ink transition-colors duration-150 group-hover:text-accent md:text-[1.6rem]">
                {project.data.title}
              </h3>
              <p class="mt-2 max-w-prose leading-relaxed text-ink-soft">
                {project.data.tagline}
              </p>
              <p class="mt-3 text-sm text-ink-soft">{project.data.stack.join(" · ")}</p>
            </div>
            <span class="link-underline self-start text-sm font-bold md:mt-1 md:font-normal">
              View
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
