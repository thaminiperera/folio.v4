---
import { site } from "../site";

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-rule/80 bg-paper/85 backdrop-blur-sm">
  <div class="mx-auto flex max-w-5xl items-baseline justify-between gap-6 px-6 py-4 md:px-10">
    <a href="/" class="font-display text-lg tracking-tight text-ink hover:text-accent">
      {site.name}
    </a>
    <nav aria-label="Primary" class="flex flex-wrap items-baseline gap-x-5 gap-y-1 text-sm text-ink-soft">
      <a
        href="/#work"
        class:list={["hover:text-accent", path.startsWith("/work") && "text-accent"]}
      >
        Work
      </a>
      <a href={`mailto:${site.email}`} class="hover:text-accent">Email</a>
      <a href={site.github} rel="me" class="hover:text-accent">GitHub</a>
      <a href={site.linkedin} rel="me" class="hover:text-accent">LinkedIn</a>
    </nav>
  </div>
</header>
