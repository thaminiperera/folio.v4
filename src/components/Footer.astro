---
import { site } from "../site";
---

<footer class="relative mt-24 overflow-hidden border-t border-rule">
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-28 opacity-70" aria-hidden="true">
    <svg class="h-full w-full text-moss/25" viewBox="0 0 1200 140" preserveAspectRatio="none">
      <path
        fill="currentColor"
        d="M0 140h1200V78c-80-28-160-8-240-22S800 18 720 32 560 90 480 78 320 18 240 32 80 90 0 70v70Z"
      ></path>
      <path
        fill="currentColor"
        class="text-ink/[0.06]"
        d="M0 140h1200V96c-120-18-220-40-340-28S640 120 520 108 280 56 160 72 40 110 0 104v36Z"
      ></path>
    </svg>
  </div>
  <div class="relative mx-auto flex max-w-5xl flex-col gap-3 px-6 py-10 text-sm text-ink-soft md:flex-row md:items-end md:justify-between md:px-10">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p class="flex flex-wrap gap-x-4 gap-y-1">
      <a class="hover:text-accent" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="hover:text-accent" href={site.github}>GitHub</a>
      <a class="hover:text-accent" href={site.linkedin}>LinkedIn</a>
    </p>
  </div>
</footer>
